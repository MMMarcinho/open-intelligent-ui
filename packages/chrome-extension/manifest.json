{
  "manifest_version": 3,
  "name": "Open Intelligent UI Preview",
  "version": "0.2.1",
  "version_name": "0.2.1-stream",
  "description": "Render valid Open Intelligent UI replies on supported chat sites.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Intelligent UI", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*"],
    "js": ["content.js"],
    "css": ["hidden.css"],
    "run_at": "document_idle"
  }]
}
