{
  "name": "open-intelligent-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./protocol": { "types": "./dist/lib/protocol/index.d.ts", "import": "./dist/lib/protocol/index.js" },
    "./react-ui": { "types": "./dist/lib/packages/react-ui/index.d.ts", "import": "./dist/lib/packages/react-ui/index.js" },
    "./muse-app-adapter": { "types": "./dist/lib/packages/muse-app-adapter/index.d.ts", "import": "./dist/lib/packages/muse-app-adapter/index.js" },
    "./styles.css": "./ui/styles.css"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "npm run build:lib && npm run schema && npm run build:playground && npm run build:extension && npm run build:dsh-plugin",
    "build:lib": "rm -rf dist/lib && tsc -p tsconfig.build.json",
    "build:playground": "vite build --configLoader runner",
    "build:extension": "node packages/chrome-extension/build.mjs",
    "build:dsh-plugin": "node packages/dsh-plugin/build.mjs",
    "verify:deepseek-snapshot": "npm run build:lib && node test/verify-deepseek-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:lib && npm run build:dsh-plugin && tsx --test test/*.test.ts",
    "schema": "tsx protocol/export-schema.ts",
    "gallery:coverage": "tsx test/export-gallery-coverage.ts"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/react": "19.3.0",
    "@types/jsdom": "20.0.1",
    "esbuild": "0.17.19",
    "jsdom": "20.0.3",
    "tsx": "3.12.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
